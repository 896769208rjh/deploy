# ── 数据库 ────────────────────────────────────────────
POSTGRES_PASSWORD=换成随机强密码

# ── 安全密钥（随机生成，不要用默认值）──────────────────
JWT_SECRET=换成随机32位字符串
INTERNAL_TOKEN=换成随机32位字符串

# ── 管理员账号 ─────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=换成强密码

# ── MinIO 对象存储（可选，不填则用本地磁盘） ────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=换成随机密码
MINIO_PUBLIC_ENDPOINT=你的服务器IP:9000

# ── DeepSeek 博客助手 ──────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 镜像仓库（GitHub 用户名/仓库名，小写）─────────────
# 例如：your-github-username/ai-platform
GITHUB_REPOSITORY=your-github-username/ai-platform

# ── 前端跨域（用你的域名或 IP）────────────────────────
# 多个用逗号分隔
CORS_ORIGINS=http://124.222.144.7:8080,http://你的域名

# ── Coolify 回调（由 Coolify Dashboard 生成，填入 GitHub Secrets）────
# 这两个不需要填到服务器上，只填到 GitHub 仓库 Secrets 里
# COOLIFY_WEBHOOK_URL=https://app.coolify.io/api/v1/deploy/webhook/xxx
# COOLIFY_TOKEN=coolify-token-xxx
